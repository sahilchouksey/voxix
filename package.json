{
  "name": "voxix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:rust": "cargo build --manifest-path core/Cargo.toml --no-default-features",
    "run": "LD_LIBRARY_PATH=\"$(echo core/target/debug/build/transcribe-cpp-sys-*/out/lib | tr ' ' ':')\" ./core/target/debug/voxix --debug --start-hidden",
    "build:deb": "tauri build --bundles deb -- --no-default-features",
    "install:deb": "sudo apt install ./core/target/release/bundle/deb/*.deb",
    "lint": "eslint ui packages/sdk/src packages/sdk/examples",
    "lint:fix": "eslint ui --fix",
    "test:sdk": "bun test packages/sdk",
    "test:unit": "bun test ui/voxix",
    "format": "prettier --write . && cd core && cargo fmt",
    "format:check": "prettier --check . && cd core && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd core && cargo fmt",
    "check:translations": "bun scripts/check-translations.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "@tauri-apps/plugin-os": "~2.3.2",
    "i18next": "^25.7.2",
    "immer": "^11.1.3",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.4.1",
    "sonner": "^2.0.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^24.9.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-i18next": "^6.1.3",
    "prettier": "^3.6.2",
    "typescript": "~5.6.3",
    "vite": "^6.4.1"
  }
}
